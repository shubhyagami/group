# Copy to .env and fill in real values.
APP_NAME=OmniMart AI E-Commerce Backend
APP_VERSION=1.0.0
DEBUG=true
HOST=0.0.0.0
PORT=8080

DATABASE_URL=sqlite:///./omnimart.db
SECRET_KEY=change-me-to-a-long-random-string
SESSION_COOKIE_NAME=omnimart_session
SESSION_MAX_AGE=604800

NVIDIA_API_KEYS=key1,key2,key3
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
AI_PROVIDER=nvidia

LOCAL_AI_BASE_URL=http://localhost:8000/v1
LOCAL_AI_MODEL=nvidia/nemotron-3-nano-30b-a3b
AI_TIMEOUT_MS=2500

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=OmniMart AI

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
SEED_DEMO_DATA=true